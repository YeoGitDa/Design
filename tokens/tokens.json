{
  "$description": "여백 디자인 토큰 — Figma 「여백 디자인 시스템」 Variables 와 같은 값. 값을 바꿀 때는 여기와 Figma 를 같이 고친다",
  "color": {
    "leaf":     { "$type": "color", "$value": "#3A8C75", "$description": "대표색 — 큰 제목·아이콘 바탕·장식. 흰 바탕 작은 글자 금지 (대비 4.05)" },
    "forest":   { "$type": "color", "$value": "#31594E", "$description": "버튼·링크·라벨 (대비 7.87)" },
    "deep":     { "$type": "color", "$value": "#09402C", "$description": "버튼 누름·진한 띠" },
    "night":    { "$type": "color", "$value": "#0A261C", "$description": "어두운 바탕 (푸터)" },
    "ink":      { "$type": "color", "$value": "#0D0D0D", "$description": "제목 글자" },
    "leaf-6":   { "$type": "color", "$value": "#F3F8F7", "$description": "구역 바탕" },
    "leaf-12":  { "$type": "color", "$value": "#E7F1EE", "$description": "선택된 메뉴·아이콘 칸" },
    "leaf-24":  { "$type": "color", "$value": "#D0E3DE", "$description": "강조 선" },
    "gray-600": { "$type": "color", "$value": "#475569", "$description": "본문" },
    "gray-500": { "$type": "color", "$value": "#64748B", "$description": "보조 글자" },
    "gray-200": { "$type": "color", "$value": "#E2E8F0", "$description": "선·카드 테두리" },
    "bg":       { "$type": "color", "$value": "#F8FAFC", "$description": "페이지 바탕" },
    "white":    { "$type": "color", "$value": "#FFFFFF", "$description": "카드" },
    "danger":   { "$type": "color", "$value": "#DC2626", "$description": "오류 표시 전용 — CI 밖 예외" }
  },
  "semantic": {
    "text": {
      "heading":   { "$type": "color", "$value": "{color.ink}" },
      "body":      { "$type": "color", "$value": "{color.gray-600}" },
      "muted":     { "$type": "color", "$value": "{color.gray-500}" },
      "on-accent": { "$type": "color", "$value": "{color.white}" },
      "accent":    { "$type": "color", "$value": "{color.forest}" },
      "disabled":  { "$type": "color", "$value": "{color.gray-500}" }
    },
    "surface": {
      "page":        { "$type": "color", "$value": "{color.bg}" },
      "card":        { "$type": "color", "$value": "{color.white}" },
      "accent-soft": { "$type": "color", "$value": "{color.leaf-12}" },
      "section-alt": { "$type": "color", "$value": "{color.leaf-6}" },
      "dark":        { "$type": "color", "$value": "{color.night}" },
      "disabled":    { "$type": "color", "$value": "{color.leaf-6}" }
    },
    "border": {
      "default": { "$type": "color", "$value": "{color.gray-200}" },
      "accent":  { "$type": "color", "$value": "{color.forest}" },
      "focus":   { "$type": "color", "$value": "{color.leaf}" }
    },
    "button": {
      "primary-bg":         { "$type": "color", "$value": "{color.forest}" },
      "primary-bg-hover":   { "$type": "color", "$value": "{color.deep}" },
      "primary-bg-pressed": { "$type": "color", "$value": "{color.night}" },
      "secondary-bg-hover": { "$type": "color", "$value": "{color.leaf-12}" }
    },
    "brand": {
      "primary": { "$type": "color", "$value": "{color.leaf}" }
    }
  },
  "radius": {
    "card": { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "9999px" }
  },
  "shadow": {
    "rest":  { "$type": "shadow", "$value": "0 1px 2px 0 rgb(0 0 0 / 0.05)" },
    "hover": { "$type": "shadow", "$value": "0 4px 6px -1px rgb(0 0 0 / 0.1)" }
  },
  "space": {
    "card-gap":  { "$type": "dimension", "$value": "20px" },
    "card-pad":  { "$type": "dimension", "$value": "24px" },
    "section-y": { "$type": "dimension", "$value": "80px" },
    "page-x":    { "$type": "dimension", "$value": "24px", "$description": "폰 20px" },
    "content":   { "$type": "dimension", "$value": "1024px" }
  },
  "breakpoint": {
    "phone":  { "width": 390,  "columns": 4,  "margin": 20, "gutter": 16 },
    "tablet": { "width": 768,  "columns": 8,  "margin": 24, "gutter": 20 },
    "pc":     { "width": 1440, "columns": 12, "content": 1024, "gutter": 20 }
  },
  "font": {
    "family": {
      "base":  { "$type": "fontFamily", "$value": ["Pretendard Variable", "Pretendard", "-apple-system", "system-ui", "sans-serif"] },
      "brand": { "$type": "fontFamily", "$value": ["Montserrat", "Pretendard Variable", "sans-serif"], "$description": "로고·영문 라벨 전용 — 한글 없음" }
    },
    "style": {
      "title":      { "size": 36, "mobileSize": 30, "lineHeight": 40, "weight": 700, "letterSpacing": "-0.025em" },
      "card-title": { "size": 18, "lineHeight": 28, "weight": 700 },
      "label":      { "size": 12, "lineHeight": 16, "weight": 700, "letterSpacing": "0.14em", "transform": "uppercase", "family": "brand" },
      "logo":       { "size": 18, "lineHeight": 24, "weight": 700, "letterSpacing": "0.02em", "family": "brand" },
      "body":       { "size": 14, "lineHeight": 23, "weight": 400 },
      "body-long":  { "size": 16, "lineHeight": 26, "weight": 400 },
      "button":     { "size": 14, "lineHeight": 20, "weight": 600 }
    }
  }
}
